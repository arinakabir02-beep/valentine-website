<!DOCTYPE html>
<html>
<head>
<title>Will You Be My Valentine? ❤️</title>

<style>
body{
    background: linear-gradient(to right, #ff9a9e, #fecfef);
    text-align:center;
    font-family: Arial;
    margin-top:120px;
}

h1{
    font-size:50px;
    color:#d6004c;
}

button{
    padding:15px 35px;
    font-size:22px;
    margin:20px;
    border:none;
    border-radius:15px;
    cursor:pointer;
}

#yes{
    background:#ff2e63;
    color:white;
}

#no{
    background:#eeeeee;
}
</style>

<script>
function yesClick(){
    document.body.innerHTML = "<h1>Yayyy ❤️ You made me the happiest!</h1>";
}

function moveNo(){
    var x = Math.random()*window.innerWidth-100;
    var y = Math.random()*window.innerHeight-100;
    document.getElementById("no").style.position="absolute";
    document.getElementById("no").style.left = x + "px";
    document.getElementById("no").style.top = y + "px";
}
</script>
</head>

<body>

<h1>Will you be my Valentine? ❤️</h1>

<button id="yes" onclick="yesClick()">YES</button>
<button id="no" onmouseover="moveNo()">NO</button>

</body>
</html>
